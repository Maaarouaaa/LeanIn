# Supabase project URL, e.g. https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server write key — either name works:
# - SUPABASE_SERVICE_ROLE_KEY (legacy JWT service-role key)
# - SUPABASE_SECRET_KEY (newer sb_secret_... key)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# If required public vars are unset, or the circles probe fails, the app uses
# the labeled in-memory development fallback.
