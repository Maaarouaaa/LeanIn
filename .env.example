# Supabase project URL, e.g. https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe for browser; used by server client too in this prototype)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: service role key for trusted server-side writes.
# Prefer this in production server environments; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# If the variables above are unset, the app uses a labeled in-memory development
# fallback so reviewers can still walk the full Circle Match flow.
